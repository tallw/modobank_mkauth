    <script>
    $(document).ready(function() {
        $('#logoutForm').on('submit', function(event) {
            event.preventDefault();
            $.ajax({
                url: 'logout.hhvm',
                method: 'POST',
                success: function() {
                    window.location.href = 'index.hhvm';
                }
            });
        });
    });
    </script>
